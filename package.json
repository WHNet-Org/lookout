{
  "name": "lookout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node src/node.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.ts",
    "test": "node --test --test-reporter=spec test/*.test.ts",
    "test:worker": "node scripts/worker-smoke.ts",
    "test:browser": "node scripts/browser-check.ts",
    "dev:worker": "wrangler dev --test-scheduled",
    "prepare:staging": "node scripts/prepare-staging.ts",
    "verify:staging": "node scripts/staging-check.ts",
    "verify:staging:metrics": "node scripts/staging-metrics.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "re2js": "2.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2",
    "wrangler": "4.166.0"
  }
}
